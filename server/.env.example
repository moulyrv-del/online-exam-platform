# Copy this file to ".env" and fill in your own values. Never commit ".env".
PORT=5000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=exam_platform

# Any long random text. Used to sign login tokens.
JWT_SECRET=replace_with_a_long_random_string

# Used by "npm run db:setup" to create the admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_an_admin_password
